{
  "$defs": {
    "Job": {
      "properties": {
        "job_id": {
          "pattern": "^job_[A-Za-z0-9]+$",
          "title": "Job Id",
          "type": "string"
        },
        "company_id": {
          "pattern": "^co_[A-Za-z0-9]+$",
          "title": "Company Id",
          "type": "string"
        },
        "required_skills": {
          "additionalProperties": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "title": "Required Skills",
          "type": "object"
        },
        "optional_skills": {
          "additionalProperties": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "default": {},
          "title": "Optional Skills",
          "type": "object"
        },
        "minimum_experience": {
          "minimum": 0,
          "title": "Minimum Experience",
          "type": "number"
        },
        "locations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Locations",
          "type": "array"
        },
        "work_mode": {
          "$ref": "#/$defs/WorkMode"
        },
        "salary_lpa": {
          "exclusiveMinimum": 0,
          "title": "Salary Lpa",
          "type": "number"
        }
      },
      "required": [
        "job_id",
        "company_id",
        "required_skills",
        "minimum_experience",
        "locations",
        "work_mode",
        "salary_lpa"
      ],
      "title": "Job",
      "type": "object"
    },
    "Student": {
      "properties": {
        "student_id": {
          "pattern": "^stu_[A-Za-z0-9]+$",
          "title": "Student Id",
          "type": "string"
        },
        "verified_skills": {
          "additionalProperties": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "title": "Verified Skills",
          "type": "object"
        },
        "years_experience": {
          "maximum": 50,
          "minimum": 0,
          "title": "Years Experience",
          "type": "number"
        },
        "preferred_locations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Preferred Locations",
          "type": "array"
        },
        "work_modes": {
          "items": {
            "$ref": "#/$defs/WorkMode"
          },
          "title": "Work Modes",
          "type": "array",
          "uniqueItems": true
        },
        "expected_salary_lpa": {
          "exclusiveMinimum": 0,
          "title": "Expected Salary Lpa",
          "type": "number"
        }
      },
      "required": [
        "student_id",
        "verified_skills",
        "years_experience",
        "preferred_locations",
        "work_modes",
        "expected_salary_lpa"
      ],
      "title": "Student",
      "type": "object"
    },
    "WorkMode": {
      "enum": [
        "remote",
        "hybrid",
        "onsite"
      ],
      "title": "WorkMode",
      "type": "string"
    }
  },
  "properties": {
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "student": {
      "$ref": "#/$defs/Student"
    },
    "jobs": {
      "items": {
        "$ref": "#/$defs/Job"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Jobs",
      "type": "array"
    },
    "limit": {
      "default": 10,
      "maximum": 50,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "student",
    "jobs"
  ],
  "title": "MatchRequest",
  "type": "object"
}
